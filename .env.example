# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret long et aléatoire (openssl rand -base64 48) : signe les sessions et hache les IP
SESSION_SECRET=

# ── Base de données Neon ────────────────────────────────────
# Chaîne de connexion (console Neon > Connect, version "pooled")
DATABASE_URL=

# ── FlexPay (Mobile Money + carte, RDC) ─────────────────────
FLEXPAY_MERCHANT=
FLEXPAY_TOKEN=
# Secret ajouté à l'URL de callback (openssl rand -hex 24)
FLEXPAY_CALLBACK_SECRET=
# URLs : valeurs par défaut ci-dessous, à confirmer avec la documentation FlexPay de votre compte
FLEXPAY_API_BASE=https://backend.flexpay.cd/api/rest/v1
FLEXPAY_CARD_URL=https://cardpayment.flexpay.cd/v1.1/pay
# FLEXPAY_CHECK_BASE=https://backend.flexpay.cd/api/rest/v1/check

# ── Prix ────────────────────────────────────────────────────
# Taux utilisé pour calculer le prix en CDF (1 USD = X CDF). À tenir à jour.
USD_CDF_RATE=2800

# ── Photos (Vercel Blob) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
# ALLOWED_IMAGE_HOST_SUFFIX=.public.blob.vercel-storage.com

# ── Anti-bots (Cloudflare Turnstile, optionnel mais recommandé) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
